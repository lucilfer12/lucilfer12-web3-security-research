{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "W3Sec intake report",
  "type": "object",
  "required": ["intake_version", "id", "captured_at", "target", "git", "toolchain", "summary", "files", "contracts"],
  "properties": {
    "intake_version": {"type": "string"},
    "id": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "required": ["kind", "path", "name", "source_hash"],
      "properties": {
        "kind": {"enum": ["file", "repository", "archive"]},
        "path": {"type": "string"},
        "name": {"type": "string"},
        "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "git": {"type": "object"},
    "toolchain": {"type": "object", "required": ["project_files", "local_tools"]},
    "summary": {
      "type": "object",
      "required": ["file_count", "source_file_count", "contract_count", "function_count", "total_bytes", "security_signal_kinds"],
      "properties": {
        "file_count": {"type": "integer", "minimum": 0},
        "source_file_count": {"type": "integer", "minimum": 0},
        "contract_count": {"type": "integer", "minimum": 0},
        "function_count": {"type": "integer", "minimum": 0},
        "total_bytes": {"type": "integer", "minimum": 0},
        "security_signal_kinds": {"type": "array", "items": {"type": "string"}}
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes", "lines", "language", "pragma_solidity", "imports", "signals", "contract_count", "function_count"],
        "properties": {
          "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}, "lines": {"type": "integer", "minimum": 0},
          "language": {"type": "string"}, "pragma_solidity": {"type": "array"},
          "imports": {"type": "array", "items": {"type": "string"}}, "signals": {"type": "array"},
          "contract_count": {"type": "integer", "minimum": 0}, "function_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "line", "bases", "file", "function_count", "functions", "signals"],
        "properties": {
          "id": {"type": "string"}, "name": {"type": "string"}, "kind": {"type": "string"},
          "line": {"type": "integer", "minimum": 1}, "bases": {"type": "array"},
          "file": {"type": "string"}, "function_count": {"type": "integer", "minimum": 0},
          "functions": {"type": "array"}, "signals": {"type": "array"}
        }
      }
    }
  }
}
